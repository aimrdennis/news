---
import MainLayout from "../../layouts/MainLayout.astro";
import { SITE } from "../../lib/site";



import { getCollection } from "astro:content";

// ambil blog
let posts = await getCollection("blog");

// sort terbaru (pakai date dari frontmatter)
posts = posts.sort(
  (a, b) => new Date(b.data.date) - new Date(a.data.date)
);
---

<MainLayout
  title={`Blog | ${SITE.title}`}
  description={SITE.description}
  canonical={SITE.url("/blog")}
>

 
<main class="container">

  <section class="hero">
    <h1>Blog</h1>

    <p>
      Explore modern articles, AI tools,
      Cloudflare Workers tutorials,
      Astro guides, and web development insights.
    </p>
  </section>

  <section class="grid">

    {posts.map((post) => (
      <article class="card">

        <a
          href={`/blog/${post.slug}/`}
          class="card-link"
        >

          <div class="thumb">

            <img
              src={SITE.url(`/api/og/${post.slug}.svg`)}
              alt={post.data.title}
              loading="lazy"
              width="1200"
              height="630"
            />

          </div>

          <div class="content">

            <h2>
              {post.data.title}
            </h2>

            {post.data.description && (
              <p>
                {post.data.description}
              </p>
            )}

            <span class="readmore">
              Read Article →
            </span>

          </div>

        </a>

      </article>
    ))}

  </section>

</main>

<style>
  :root{
    --bg:#0f172a;
    --card:#111827;
    --border:#1e293b;
    --text:#f8fafc;
    --muted:#94a3b8;
    --primary:#2563eb;
  }

  body{
    background:var(--bg);
    color:var(--text);
    font-family:Arial,sans-serif;
  }

  .container{
    width:min(1180px,92%);
    margin:auto;
    padding:70px 0;
  }

  .hero{
    text-align:center;
    margin-bottom:50px;
  }

  .hero h1{
    font-size:48px;
    margin-bottom:14px;
  }

  .hero p{
    color:var(--muted);
    max-width:760px;
    margin:auto;
    line-height:1.7;
  }

  .grid{
    display:grid;
    grid-template-columns:
      repeat(auto-fit,minmax(320px,1fr));
    gap:26px;
  }

  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:24px;
    overflow:hidden;
    transition:.25s ease;
  }

  .card:hover{
    transform:translateY(-4px);
    border-color:var(--primary);
  }

  .card-link{
    display:block;
    color:inherit;
    text-decoration:none;
  }

  .thumb{
    position:relative;
    overflow:hidden;
    aspect-ratio:1200/630;
    background:#020617;
  }

  .thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:transform .35s ease;
  }

  .card:hover img{
    transform:scale(1.03);
  }

  .content{
    padding:22px;
  }

  .content h2{
    font-size:23px;
    line-height:1.4;
    margin-bottom:12px;
  }

  .content p{
    color:var(--muted);
    font-size:15px;
    line-height:1.7;
    margin-bottom:18px;
  }

  .readmore{
    display:inline-flex;
    align-items:center;
    gap:6px;
    color:#60a5fa;
    font-size:14px;
    font-weight:700;
  }

  @media(max-width:768px){

    .container{
      padding:50px 0;
    }

    .hero h1{
      font-size:36px;
    }

    .grid{
      grid-template-columns:1fr;
      gap:20px;
    }

  }
</style>
