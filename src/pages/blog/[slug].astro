---
import MainLayout from '../../layouts/MainLayout.astro';
import { SITE } from '../../lib/site';
import "../../styles/blog.css";

import RelatedPosts from "../../components/RelatedPosts.astro";

import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: {
      slug: post.slug
    },
    props: {
      post
    }
  }));
}

const { post } = Astro.props;

const { Content, headings } = await render(post);

const posts = await getCollection("blog");
---

<MainLayout
  title={`${post.data.title} | ${SITE.title}`}
  description={post.data.description}
  canonical={SITE.url(`/blog/${post.slug}`)}
  amp={SITE.url(`/blog/${post.slug}/amp`)}
  slug={post.slug}
>

  <main class="post-wrap">

    <article class="post">

      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>

        <a href="/blog/">Blog</a>
        <span>/</span>

        <span>{post.data.title}</span>
      </nav>

      <!-- Title -->
<!-- GANTI BAGIAN INI -->
<header class="post-header">

  <h1>
    {post.data.title}
  </h1>

  {post.data.description && (
    <p class="excerpt">
      {post.data.description}
    </p>
  )}

</header>

<!-- MENJADI INI -->
<header class="post-header sticky-cta">

  <div class="sticky-content">

    <div class="sticky-text">

      <h1>
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="excerpt">
          {post.data.description}
        </p>
      )}

    </div>

    <a
      href="/tools/"
      class="cta-btn"
    >
      Coba Sekarang
    </a>

  </div>

</header>

      <!-- Featured Image -->
      <div class="featured-image">

        <img
          src={SITE.url(`/api/og/${post.slug}.svg`)}
          alt={post.data.title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width="1200"
          height="630"
        />

      </div>

      <!-- TOC -->
      {headings.length > 0 && (
        <details class="toc">

          <summary class="toc-title">
            <span>📑 Daftar Isi</span>
          </summary>

          <ul>

            {headings.map((heading) => (
              <li class={`depth-${heading.depth}`}>

                <a href={`#${heading.slug}`}>
                  {heading.text}
                </a>

              </li>
            ))}

          </ul>

        </details>
      )}

      <!-- CONTENT -->
      <section class="content">
        <Content />
      </section>

      <!-- Related -->
      <RelatedPosts
        posts={posts}
        currentSlug={post.slug}
      />

    </article>

  </main>

</MainLayout>

<style>
  :root{
    --bg:#0f172a;
    --card:#111827;
    --border:#1e293b;
    --text:#f8fafc;
    --muted:#94a3b8;
    --primary:#2563eb;
  }

  .post-wrap{
    width:min(860px,92%);
    margin:auto;
    padding:40px 0 80px;
  }

  .post{
    background:transparent;
  }

  .breadcrumb{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    align-items:center;
    margin-bottom:28px;
    font-size:14px;
    color:var(--muted);
  }

  .breadcrumb a{
    color:var(--muted);
    text-decoration:none;
  }

  .breadcrumb a:hover{
    color:#fff;
  }

  .post-header{
    margin-bottom:30px;
  }

  .post-header h1{
    font-size:clamp(34px,5vw,52px);
    line-height:1.2;
    margin-bottom:18px;
    color:var(--text);
  }

  .excerpt{
    font-size:18px;
    line-height:1.8;
    color:var(--muted);
  }

  .featured-image{
    overflow:hidden;
    border-radius:28px;
    border:1px solid var(--border);
    margin-bottom:34px;
    background:#020617;
  }

  .featured-image img{
    width:100%;
    height:auto;
    display:block;
  }

  .toc{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:22px;
    padding:22px;
    margin-bottom:40px;
  }

  .toc-title{
    cursor:pointer;
    list-style:none;
    font-weight:700;
    font-size:17px;
  }

  .toc-title::-webkit-details-marker{
    display:none;
  }

  .toc ul{
    margin-top:18px;
    padding-left:18px;
  }

  .toc li{
    margin:10px 0;
  }

  .toc a{
    color:#cbd5e1;
    text-decoration:none;
    line-height:1.6;
  }

  .toc a:hover{
    color:#fff;
  }

  .depth-3{
    margin-left:18px;
  }

  .depth-4{
    margin-left:36px;
  }

  .content{
    color:#e2e8f0;
    line-height:1.9;
    font-size:18px;
  }

  .content :global(h2){
    margin-top:60px;
    margin-bottom:18px;
    font-size:34px;
    line-height:1.3;
    color:#fff;
  }

  .content :global(h3){
    margin-top:40px;
    margin-bottom:14px;
    font-size:26px;
    line-height:1.4;
    color:#fff;
  }

  .content :global(p){
    margin-bottom:24px;
  }

  .content :global(a){
    color:#60a5fa;
    text-decoration:none;
  }

  .content :global(img){
    width:100%;
    height:auto;
    border-radius:22px;
    margin:30px 0;
    border:1px solid var(--border);
  }

  .content :global(pre){
    overflow:auto;
    padding:22px;
    border-radius:22px;
    background:#020617;
    border:1px solid var(--border);
    margin:28px 0;
  }

  .content :global(code){
    font-size:15px;
  }

  .content :global(blockquote){
    border-left:4px solid var(--primary);
    padding-left:20px;
    margin:28px 0;
    color:#cbd5e1;
  }

  .content :global(ul),
  .content :global(ol){
    padding-left:24px;
    margin-bottom:24px;
  }

  .content :global(li){
    margin:10px 0;
  }

  @media(max-width:768px){

    .post-wrap{
      padding-top:24px;
    }

    .post-header h1{
      font-size:34px;
    }

    .excerpt{
      font-size:16px;
    }

    .content{
      font-size:17px;
    }

    .content :global(h2){
      font-size:28px;
    }

    .content :global(h3){
      font-size:22px;
    }

  }

.sticky-cta{
  position:sticky;
  top:0;
  z-index:60;

  background:
    rgba(15,23,42,.82);

  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);

  border-bottom:
    1px solid rgba(255,255,255,.06);

  margin-bottom:28px;
}

.sticky-content{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;

  padding:16px 0;
}

.sticky-text{
  flex:1;
  min-width:0;
}

.sticky-text h1{
  font-size:24px;
  line-height:1.3;
  margin-bottom:5px;

  display:-webkit-box;
  -webkit-line-clamp:1;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.sticky-text .excerpt{
  margin:0;
  font-size:14px;
  color:#94a3b8;

  display:-webkit-box;
  -webkit-line-clamp:1;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.cta-btn{
  flex-shrink:0;

  display:inline-flex;
  align-items:center;
  justify-content:center;

  padding:12px 18px;

  border-radius:14px;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #3b82f6
    );

  color:#fff;
  text-decoration:none;

  font-size:14px;
  font-weight:700;

  transition:.25s ease;
}

.cta-btn:hover{
  transform:translateY(-2px);
  opacity:.95;
}

@media(max-width:768px){

  .sticky-content{
    gap:14px;
    align-items:flex-start;
  }

  .sticky-text h1{
    font-size:18px;
  }

  .sticky-text .excerpt{
    font-size:13px;
  }

  .cta-btn{
    padding:10px 14px;
    font-size:13px;
    border-radius:12px;
  }

}
</style>
