---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';


const pageTitle =
  'Tools Ai Mr Dennis - Teknologi, AI, Tools, SEO & Digital Modern';

const pageDescription =
  'Ai Mr Dennis membahas AI, teknologi, SEO, tools digital, tutorial modern, automation, dan insight internet terbaru dengan tampilan cepat dan ringan.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
>


  <!-- HERO -->
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <h1>
            Ai Mr Dennis — Solusi Digital Growth untuk Bisnis Modern
          </h1>

          <p>
            Ai Mr Dennis membantu bisnis membangun visibility, authority, dan pertumbuhan digital melalui strategi modern berbasis data.
          </p>

          <div class="button-group">
            <a href="#contact" class="btn btn-primary">
              Konsultasi Gratis
            </a>

            <a href="#case-study" class="btn btn-secondary">
              Lihat Portfolio
            </a>
          </div>

          <div class="trust-list">
            <span>✔ 120+ Client</span>
            <span>✔ Transparent Reporting</span>
            <span>✔ Growth Strategy</span>
          </div>
        </div>

        <div class="card">
          <h3>Ai Mr Dennis Performance</h3>

          <div class="stats">
            <div class="stat-item">
              <strong>+312%</strong>
              <p>Organic Traffic</p>
            </div>

            <div class="stat-item">
              <strong>+180</strong>
              <p>Monthly Leads</p>
            </div>

            <div class="stat-item">
              <strong>5 Bulan</strong>
              <p>Average Growth</p>
            </div>

            <div class="stat-item">
              <strong>90%</strong>
              <p>Client Retention</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST LOGO -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>Dipercaya oleh Berbagai Bisnis</h2>
          <p>
            Kami membantu brand, UMKM, startup, dan perusahaan meningkatkan
            visibility organik di Google.
          </p>
        </div>

        <div class="logo-grid">
          <div class="logo-box">Client Logo</div>
          <div class="logo-box">Client Logo</div>
          <div class="logo-box">Client Logo</div>
          <div class="logo-box">Client Logo</div>
          <div class="logo-box">Client Logo</div>
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>Masalah Digital yang Sering Dialami Bisnis</h2>
        </div>

        <div class="problem-grid">
          <div class="problem-item">
            <h3>Traffic Stagnan</h3>
            <p>
              Website sulit mendapatkan traffic organik walau sudah publish
              banyak konten.
            </p>
          </div>

          <div class="problem-item">
            <h3>Leads Sedikit</h3>
            <p>
              Visitor datang tetapi tidak menghasilkan conversion atau inquiry.
            </p>
          </div>

          <div class="problem-item">
            <h3>Kalah dengan Kompetitor</h3>
            <p>
              Kompetitor muncul di halaman pertama Google sementara website Anda
              tertinggal.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SOLUTION -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>Solusi Digital dari Ai Mr Dennis</h2>
        </div>

        <div class="solution-grid">
          <div class="solution-item">
            <h3>Digital Strategy</h3>
            <p>
              Audit struktur website, kecepatan, indexing, dan technical issues.
            </p>
          </div>

          <div class="solution-item">
            <h3>Content & Brand Strategy</h3>
            <p>
              Strategi content cluster dan topical authority untuk growth
              jangka panjang.
            </p>
          </div>

          <div class="solution-item">
            <h3>Optimization & Conversion</h3>
            <p>
              Optimasi search intent, heading structure, semantic keyword, dan
              UX.
            </p>
          </div>

          <div class="solution-item">
            <h3>Authority & Visibility</h3>
            <p>
              Membangun trust dan authority website secara natural dan aman.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>Cara Kerja Ai Mr Dennis</h2>
        </div>

        <div class="process-wrapper">
          <div class="process-item">
            <div class="process-number">1</div>
            <div>
              <h3>SEO Audit</h3>
              <p>
                Analisis menyeluruh terhadap technical SEO, content, dan
                kompetitor.
              </p>
            </div>
          </div>

          <div class="process-item">
            <div class="process-number">2</div>
            <div>
              <h3>Strategy Planning</h3>
              <p>
                Menentukan keyword, search intent, dan roadmap growth.
              </p>
            </div>
          </div>

          <div class="process-item">
            <div class="process-number">3</div>
            <div>
              <h3>Optimization</h3>
              <p>
                Implementasi technical SEO, content optimization, dan authority
                strategy.
              </p>
            </div>
          </div>

          <div class="process-item">
            <div class="process-number">4</div>
            <div>
              <h3>Monitoring & Reporting</h3>
              <p>
                Tracking keyword, traffic, conversion, dan continuous
                improvement.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CASE STUDY -->
    <section id="case-study">
      <div class="container">
        <div class="section-title">
          <h2>Case Study Growth</h2>
        </div>

        <div class="case-study">
          <div class="case-study-grid">
            <div>
              <div class="case-metrics">
                <div class="metric-box">
                  <strong>+312%</strong>
                  Traffic Growth
                </div>

                <div class="metric-box">
                  <strong>+180</strong>
                  Monthly Leads
                </div>
              </div>

              <h3>E-Commerce Fashion</h3>

              <p>
                Website mengalami traffic stagnan selama 1 tahun. Setelah audit,
                content restructuring, dan topical authority strategy,
                pertumbuhan organik meningkat signifikan dalam 5 bulan.
              </p>
            </div>

            <div class="placeholder-image">
              Analytics Screenshot Placeholder
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BENEFIT -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>Kenapa Memilih Ai Mr Dennis</h2>
        </div>

        <div class="benefit-grid">
          <div class="benefit-item">
            <h3>Data-Driven Strategy</h3>
            <p>
              Semua keputusan SEO berbasis data dan search intent analysis.
            </p>
          </div>

          <div class="benefit-item">
            <h3>Transparent Reporting</h3>
            <p>
              Laporan rutin untuk keyword, traffic, dan conversion growth.
            </p>
          </div>

          <div class="benefit-item">
            <h3>Custom Strategy</h3>
            <p>
              Strategi SEO disesuaikan dengan niche dan target bisnis Anda.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>Apa Kata Client Kami</h2>
        </div>

        <div class="testimonial-grid">
          <div class="testimonial-item">
            <h3>⭐⭐⭐⭐⭐</h3>
            <p>
              “Traffic organik meningkat signifikan dan leads jauh lebih stabil
              dibanding ads.”
            </p>
            <br />
            <strong>Founder Startup</strong>
          </div>

          <div class="testimonial-item">
            <h3>⭐⭐⭐⭐⭐</h3>
            <p>
              “SEO strategy sangat jelas dan reporting transparan setiap bulan.”
            </p>
            <br />
            <strong>E-Commerce Owner</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- EDUCATIONAL -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>Strategi Growth Modern untuk Bisnis</h2>
          <p>
            Pertumbuhan digital modern bukan hanya soal traffic, tetapi membangun trust, authority, dan conversion yang berkelanjutan.
          </p>
        </div>

        <div class="card">
          <p>
            Strategi SEO modern fokus pada search intent, helpful content,
            topical authority, user experience, dan conversion optimization.
            Website yang memberikan pengalaman terbaik untuk user memiliki
            peluang lebih besar untuk bertahan setelah Google Core Update.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <div class="container">
        <div class="section-title">
          <h2>FAQ Ai Mr Dennis</h2>
        </div>

        <div class="faq-grid">
          <div class="faq-item">
            <h3>Berapa lama SEO bekerja?</h3>
            <p>
              Umumnya 3–6 bulan tergantung kompetisi keyword dan kondisi
              website.
            </p>
          </div>

          <div class="faq-item">
            <h3>Apakah ada garansi ranking?</h3>
            <p>
              Tidak ada pihak yang bisa menjamin ranking Google, tetapi kami
              fokus pada sustainable growth.
            </p>
          </div>

          <div class="faq-item">
            <h3>Apakah SEO cocok untuk bisnis kecil?</h3>
            <p>
              Ya, SEO sangat efektif untuk membangun traffic organik jangka
              panjang.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section>
      <div class="container">
        <div class="cta-section" id="contact">
          <h2>Siap Bertumbuh Bersama Ai Mr Dennis?</h2>

          <p>
            Konsultasikan website Anda sekarang dan dapatkan free SEO audit
            untuk mengetahui peluang growth bisnis Anda.
          </p>

          <a href="#" class="btn btn-primary">
            Jadwalkan Konsultasi
          </a>
        </div>
      </div>
    </section>
</MainLayout>
