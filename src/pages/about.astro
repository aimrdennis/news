---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="About - Ai Mr Dennis"
  description="Ai Mr Dennis membantu bisnis membangun visibility, authority, dan pertumbuhan digital melalui strategi modern berbasis data."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="badge">Digital Growth Agency</span>

        <h1>
          Ai Mr Dennis — Solusi Digital Growth untuk Bisnis Modern
        </h1>

        <p>
          Ai Mr Dennis membantu bisnis membangun visibility,
          authority, dan pertumbuhan digital melalui strategi modern
          berbasis data.
        </p>

        <div class="button-group">
          <a href="#contact" class="btn btn-primary">
            Konsultasi Gratis
          </a>

          <a href="#case-study" class="btn btn-secondary">
            Lihat Portfolio
          </a>
        </div>

        <div class="trust-list">
          <span>✔ 120+ Client</span>
          <span>✔ Transparent Reporting</span>
          <span>✔ Growth Strategy</span>
        </div>
      </div>

      <div class="card hero-card">
        <h3>Ai Mr Dennis Performance</h3>

        <div class="stats">
          <div class="stat-item">
            <strong>+312%</strong>
            <p>Organic Traffic</p>
          </div>

          <div class="stat-item">
            <strong>+180</strong>
            <p>Monthly Leads</p>
          </div>

          <div class="stat-item">
            <strong>5 Bulan</strong>
            <p>Average Growth</p>
          </div>

          <div class="stat-item">
            <strong>90%</strong>
            <p>Client Retention</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST LOGO -->
  <section>
    <div class="container">
      <div class="section-title">
        <h2>Dipercaya oleh Berbagai Bisnis</h2>

        <p>
          Kami membantu brand, UMKM, startup, dan perusahaan
          meningkatkan visibility organik di Google.
        </p>
      </div>

      <div class="logo-grid">
        <div class="logo-box">Client Logo</div>
        <div class="logo-box">Client Logo</div>
        <div class="logo-box">Client Logo</div>
        <div class="logo-box">Client Logo</div>
        <div class="logo-box">Client Logo</div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section-dark">
    <div class="container">
      <div class="section-title">
        <h2>Masalah Digital yang Sering Dialami Bisnis</h2>
      </div>

      <div class="problem-grid">
        <div class="problem-item">
          <h3>Traffic Stagnan</h3>

          <p>
            Website sulit mendapatkan traffic organik walau
            sudah publish banyak konten.
          </p>
        </div>

        <div class="problem-item">
          <h3>Leads Sedikit</h3>

          <p>
            Visitor datang tetapi tidak menghasilkan conversion
            atau inquiry.
          </p>
        </div>

        <div class="problem-item">
          <h3>Kalah dengan Kompetitor</h3>

          <p>
            Kompetitor muncul di halaman pertama Google sementara
            website Anda tertinggal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section>
    <div class="container">
      <div class="section-title">
        <h2>Solusi Digital dari Ai Mr Dennis</h2>
      </div>

      <div class="solution-grid">
        <div class="solution-item">
          <h3>Digital Strategy</h3>

          <p>
            Audit struktur website, kecepatan, indexing,
            dan technical issues.
          </p>
        </div>

        <div class="solution-item">
          <h3>Content & Brand Strategy</h3>

          <p>
            Strategi content cluster dan topical authority
            untuk growth jangka panjang.
          </p>
        </div>

        <div class="solution-item">
          <h3>Optimization & Conversion</h3>

          <p>
            Optimasi search intent, heading structure,
            semantic keyword, dan UX.
          </p>
        </div>

        <div class="solution-item">
          <h3>Authority & Visibility</h3>

          <p>
            Membangun trust dan authority website
            secara natural dan aman.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section-dark">
    <div class="container">
      <div class="section-title">
        <h2>Cara Kerja Ai Mr Dennis</h2>
      </div>

      <div class="process-wrapper">
        <div class="process-item">
          <div class="process-number">1</div>

          <div>
            <h3>SEO Audit</h3>

            <p>
              Analisis menyeluruh terhadap technical SEO,
              content, dan kompetitor.
            </p>
          </div>
        </div>

        <div class="process-item">
          <div class="process-number">2</div>

          <div>
            <h3>Strategy Planning</h3>

            <p>
              Menentukan keyword, search intent,
              dan roadmap growth.
            </p>
          </div>
        </div>

        <div class="process-item">
          <div class="process-number">3</div>

          <div>
            <h3>Optimization</h3>

            <p>
              Implementasi technical SEO,
              content optimization, dan authority strategy.
            </p>
          </div>
        </div>

        <div class="process-item">
          <div class="process-number">4</div>

          <div>
            <h3>Monitoring & Reporting</h3>

            <p>
              Tracking keyword, traffic,
              conversion, dan continuous improvement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDY -->
  <section id="case-study">
    <div class="container">
      <div class="section-title">
        <h2>Case Study Growth</h2>
      </div>

      <div class="case-study">
        <div class="case-study-grid">
          <div>
            <div class="case-metrics">
              <div class="metric-box">
                <strong>+312%</strong>
                Traffic Growth
              </div>

              <div class="metric-box">
                <strong>+180</strong>
                Monthly Leads
              </div>
            </div>

            <h3>E-Commerce Fashion</h3>

            <p>
              Website mengalami traffic stagnan selama 1 tahun.
              Setelah audit, content restructuring, dan topical authority strategy,
              pertumbuhan organik meningkat signifikan dalam 5 bulan.
            </p>
          </div>

          <div class="placeholder-image">
            Analytics Screenshot Placeholder
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFIT -->
  <section>
    <div class="container">
      <div class="section-title">
        <h2>Kenapa Memilih Ai Mr Dennis</h2>
      </div>

      <div class="benefit-grid">
        <div class="benefit-item">
          <h3>Data-Driven Strategy</h3>

          <p>
            Semua keputusan SEO berbasis data
            dan search intent analysis.
          </p>
        </div>

        <div class="benefit-item">
          <h3>Transparent Reporting</h3>

          <p>
            Laporan rutin untuk keyword,
            traffic, dan conversion growth.
          </p>
        </div>

        <div class="benefit-item">
          <h3>Custom Strategy</h3>

          <p>
            Strategi SEO disesuaikan dengan niche
            dan target bisnis Anda.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="section-dark">
    <div class="container">
      <div class="section-title">
        <h2>Apa Kata Client Kami</h2>
      </div>

      <div class="testimonial-grid">
        <div class="testimonial-item">
          <h3>⭐⭐⭐⭐⭐</h3>

          <p>
            “Traffic organik meningkat signifikan dan leads
            jauh lebih stabil dibanding ads.”
          </p>

          <strong>Founder Startup</strong>
        </div>

        <div class="testimonial-item">
          <h3>⭐⭐⭐⭐⭐</h3>

          <p>
            “SEO strategy sangat jelas dan reporting
            transparan setiap bulan.”
          </p>

          <strong>E-Commerce Owner</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATIONAL -->
  <section>
    <div class="container">
      <div class="section-title">
        <h2>Strategi Growth Modern untuk Bisnis</h2>

        <p>
          Pertumbuhan digital modern bukan hanya soal traffic,
          tetapi membangun trust, authority, dan conversion
          yang berkelanjutan.
        </p>
      </div>

      <div class="card">
        <p>
          Strategi SEO modern fokus pada search intent,
          helpful content, topical authority,
          user experience, dan conversion optimization.

          Website yang memberikan pengalaman terbaik
          untuk user memiliki peluang lebih besar
          untuk bertahan setelah Google Core Update.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-dark">
    <div class="container">
      <div class="section-title">
        <h2>FAQ Ai Mr Dennis</h2>
      </div>

      <div class="faq-grid">
        <div class="faq-item">
          <h3>Berapa lama SEO bekerja?</h3>

          <p>
            Umumnya 3–6 bulan tergantung kompetisi keyword
            dan kondisi website.
          </p>
        </div>

        <div class="faq-item">
          <h3>Apakah ada garansi ranking?</h3>

          <p>
            Tidak ada pihak yang bisa menjamin ranking Google,
            tetapi kami fokus pada sustainable growth.
          </p>
        </div>

        <div class="faq-item">
          <h3>Apakah SEO cocok untuk bisnis kecil?</h3>

          <p>
            Ya, SEO sangat efektif untuk membangun
            traffic organik jangka panjang.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="container">
      <div class="cta-section" id="contact">
        <h2>Siap Bertumbuh Bersama Ai Mr Dennis?</h2>

        <p>
          Konsultasikan website Anda sekarang dan dapatkan
          free SEO audit untuk mengetahui peluang growth bisnis Anda.
        </p>

        <a href="#" class="btn btn-primary">
          Jadwalkan Konsultasi
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :global(:root) {
    --bg: #0f172a;
    --card: #111827;
    --soft: #1e293b;
    --border: rgba(255,255,255,.08);
    --text: #f8fafc;
    --muted: #94a3b8;
    --primary: #3b82f6;
    --primary-hover: #2563eb;
    --radius: 24px;
    --container: 1180px;
  }

  section {
    padding: 90px 20px;
  }

  .container {
    width: 100%;
    max-width: var(--container);
    margin: auto;
  }

  .section-dark {
    background: rgba(255,255,255,.02);
  }

  .section-title {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 60px;
  }

  .section-title h2 {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .section-title p {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .hero {
    padding-top: 120px;
  }

  .hero-grid,
  .case-study-grid {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 40px;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(42px, 7vw, 72px);
    line-height: 1.05;
    margin: 20px 0;
  }

  .hero p {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.8;
    max-width: 620px;
  }

  .badge {
    display: inline-flex;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(59,130,246,.12);
    border: 1px solid rgba(59,130,246,.25);
    color: #93c5fd;
    font-size: 14px;
    font-weight: 700;
  }

  .button-group {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 28px;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    transition: .3s ease;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
  }

  .btn-secondary {
    border: 1px solid var(--border);
    color: white;
    background: rgba(255,255,255,.03);
  }

  .btn-secondary:hover {
    background: rgba(255,255,255,.06);
  }

  .trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 28px;
    color: var(--muted);
    font-size: 14px;
  }

  .card,
  .problem-item,
  .solution-item,
  .benefit-item,
  .testimonial-item,
  .faq-item,
  .case-study,
  .logo-box {
    background: rgba(255,255,255,.03);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .card,
  .problem-item,
  .solution-item,
  .benefit-item,
  .testimonial-item,
  .faq-item {
    padding: 32px;
  }

  .hero-card h3 {
    margin-bottom: 28px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 20px;
  }

  .stat-item {
    background: rgba(255,255,255,.03);
    border-radius: 18px;
    padding: 24px;
  }

  .stat-item strong {
    display: block;
    font-size: 32px;
    margin-bottom: 10px;
  }

  .stat-item p {
    color: var(--muted);
    font-size: 14px;
  }

  .logo-grid,
  .problem-grid,
  .solution-grid,
  .benefit-grid,
  .testimonial-grid,
  .faq-grid {
    display: grid;
    gap: 24px;
  }

  .logo-grid {
    grid-template-columns: repeat(5,1fr);
  }

  .problem-grid,
  .benefit-grid,
  .testimonial-grid {
    grid-template-columns: repeat(3,1fr);
  }

  .solution-grid,
  .faq-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .logo-box {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-weight: 700;
  }

  .problem-item h3,
  .solution-item h3,
  .benefit-item h3,
  .faq-item h3 {
    margin-bottom: 14px;
  }

  .problem-item p,
  .solution-item p,
  .benefit-item p,
  .testimonial-item p,
  .faq-item p {
    color: var(--muted);
    line-height: 1.8;
  }

  .process-wrapper {
    display: grid;
    gap: 22px;
    max-width: 900px;
    margin: auto;
  }

  .process-item {
    display: flex;
    gap: 24px;
    padding: 28px;
    border-radius: 22px;
    background: rgba(255,255,255,.03);
    border: 1px solid var(--border);
  }

  .process-number {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    flex-shrink: 0;
  }

  .process-item p {
    color: var(--muted);
    line-height: 1.7;
    margin-top: 8px;
  }

  .case-study {
    padding: 40px;
  }

  .case-metrics {
    display: flex;
    gap: 18px;
    margin-bottom: 30px;
  }

  .metric-box {
    flex: 1;
    padding: 24px;
    border-radius: 18px;
    background: rgba(255,255,255,.04);
  }

  .metric-box strong {
    display: block;
    font-size: 32px;
    margin-bottom: 8px;
  }

  .placeholder-image {
    min-height: 320px;
    border-radius: 24px;
    border: 1px dashed rgba(255,255,255,.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }

  .testimonial-item strong {
    display: inline-block;
    margin-top: 20px;
  }

  .cta-section {
    text-align: center;
    padding: 70px 40px;
    border-radius: 32px;
    background:
      linear-gradient(
        135deg,
        rgba(59,130,246,.2),
        rgba(15,23,42,.9)
      );
    border: 1px solid rgba(59,130,246,.18);
  }

  .cta-section h2 {
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .cta-section p {
    max-width: 760px;
    margin: auto auto 32px;
    color: var(--muted);
    line-height: 1.8;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .case-study-grid,
    .problem-grid,
    .benefit-grid,
    .testimonial-grid,
    .solution-grid,
    .faq-grid,
    .logo-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 80px;
    }

    section {
      padding: 70px 20px;
    }

    .hero h1 {
      font-size: 48px;
    }

    .stats {
      grid-template-columns: 1fr 1fr;
    }

    .case-metrics {
      flex-direction: column;
    }

    .process-item {
      flex-direction: column;
    }

    .cta-section {
      padding: 50px 24px;
    }
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: 38px;
    }

    .button-group {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .trust-list {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
