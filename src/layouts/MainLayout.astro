---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { generateFaqSchema } from "../lib/faq-schema";

const {
  title,
  description,
  canonical,
  html = "",
  articleSchema,
  breadcrumbs,
  amp
} = Astro.props;

const faqSchema = generateFaqSchema(html);



---

<!doctype html>
<html lang="id">
<head>
  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    articleSchema={articleSchema}
    breadcrumbs={breadcrumbs}
    faqSchema={faqSchema}
    amp={amp}
  />
  <link rel="stylesheet" href="/styles/global.css" />
</head>

<body>
  <Header />

  <main>
    <slot />
  </main>

  <Footer /><!-- SCRIPT --> <script type="module">window.toggleMenu=function(){document.getElementById("navMenu").classList.toggle("active")};window.toggleMode=function(){const e=document.documentElement;e.classList.toggle("light-mode");const t=document.getElementById("modeIcon");e.classList.contains("light-mode")?(localStorage.setItem("theme","light"),t&&(t.textContent="☀️")):(localStorage.setItem("theme","dark"),t&&(t.textContent="🌙"))};window.addEventListener("DOMContentLoaded",()=>{const e=localStorage.getItem("theme"),t=document.getElementById("modeIcon");e==="light"&&(document.documentElement.classList.add("light-mode"),t&&(t.textContent="☀️"))});</script> 


</body>
</html>
